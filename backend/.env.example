# ---------------------------------------------------------------------------
# Bahi API — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Supabase: Project Settings -> Database -> Connection string -> URI
# Use the connection *pooler* string (port 6543) for serverless/edge hosts,
# or the direct string (port 5432) for a long-running Node process.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Set to "true" when your Postgres requires TLS (Supabase does).
DATABASE_SSL=true

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000
